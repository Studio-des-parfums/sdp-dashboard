# ============================================================================
# SDP — Variables d'environnement
# Copie ce fichier vers `.env` (gitignoré, jamais commité) et remplis les valeurs.
# Seules les variables VITE_* sont exposées au frontend. Les autres restent
# côté serveur / processus principal.
# ============================================================================

# --- FRONTEND (Vite, préfixe VITE_ obligatoire) ------------------------------

# URL de base de l'API Express (backend).
VITE_API_URL=http://localhost:3001/api

# Mode "utilisateur simplifié" : welcome header sans sidebar.
# Valeurs : admin (défaut) | user
VITE_USER_MODE=admin

# URL de l'API OCR externe (hébergée sur Railway) — visionneuse / extraction de documents.
VITE_OCR_API_URL=http://127.0.0.1:8000

# URL de l'API backend du robot Nono (hébergée sur Railway) — backoffice magasin.
VITE_NONO_API_URL=https://nono-le-robot-production.up.railway.app

# Client ID Google OAuth (console Google Cloud > Credentials > OAuth 2.0 Client ID).
# Si vide, la connexion Google est désactivée.
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Auto-login de dev (skippe l'OAuth Google). Ne jamais mettre à true en prod.
# Valeurs : true | false
VITE_DEV_MODE=true

# --- BACKEND (Express + MySQL, server/) --------------------------------------

# Port du serveur Express.
PORT=3001

# Connexion MySQL (mysql2/promise).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sdp_dashboard

# --- EMAILS (Resend) ----------------------------------------------------------

# Clé API Resend (https://resend.com/api-keys) — envoi d'emails transactionnels.
RESEND_API_KEY=re_your_resend_api_key
# Expéditeur vérifié sur Resend.
RESEND_FROM_EMAIL=noreply@sdp-paris.com

# --- PUBLICATION / MISE À JOUR AUTOMATIQUE (electron-builder) -----------------

# Token GitHub (Personal Access Token, scope "repo") — utilisé uniquement pour
# `npm run publish` : crée la release + upload des installateurs et des
# manifestes de mise à jour (latest-mac.yml / latest.yml).
# Ne jamais commité ; il reste local à la machine qui publie.
GH_TOKEN=github_pat_xxxxx
